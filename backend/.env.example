# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or local instance - replace with your credentials and database name)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/your_database_name?retryWrites=true&w=majority

# JWT Authentication (generate a secure random secret key)
SECRET_KEY=<your_secret_key>

# Cloudinary Storage (for candidate resumes, profile photos, and company logos)
CLOUD_NAME=<your_cloud_name>
API_KEY=<your_api_key>
API_SECRET=<your_api_secret>

# Optional: Initial Admin Seed Utility (backend/admin/createAdmin.js)
ADMIN_EMAIL=<your_admin_email>
ADMIN_PASSWORD=<your_admin_password>
